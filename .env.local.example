# Copy to `.env.local` and adjust as needed (read outside production).

# --- Application ---
ENVIRONMENT=local
DEBUG=false
DOCS_ENABLED=true
# API_V1_PREFIX=/v1

# --- HTTP ---
HOST=0.0.0.0
PORT=8000

# --- Observability ---
LOG_LEVEL=INFO
LOG_JSON=true
METRICS_ENABLED=true
METRICS_PATH=/metrics

# --- Security ---
# Comma-separated (or JSON array). Empty API_KEYS disables authentication.
API_KEYS=
CORS_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
ALLOWED_HOSTS=*
SECURITY_HEADERS_ENABLED=true
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- Market data ---
MARKET_DATA_ENABLED=true
# Comma-separated BASE/QUOTE pairs. A pair may belong to only one provider.
BINANCE_SYMBOLS=BTC/USDT
FRANKFURTER_SYMBOLS=EUR/USD
BINANCE_WS_URL=wss://stream.binance.com:9443/stream
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v1
FRANKFURTER_POLL_SECONDS=3600
PROVIDER_REQUEST_TIMEOUT_SECONDS=10
# JSON object; threshold in seconds per provider.
PROVIDER_STALE_SECONDS={"binance":10,"frankfurter":129600}
PROVIDER_FAILURE_THRESHOLD=3
PROVIDER_BACKOFF_INITIAL_SECONDS=1
PROVIDER_BACKOFF_MAX_SECONDS=60

# --- Quotes ---
DEFAULT_SPREAD_BPS=10
# JSON object with per-symbol overrides, e.g. {"BTC/USDT":15,"EUR/USD":5}
SPREADS_BPS={}
QUOTE_TTL_SECONDS=30
QUOTE_RETENTION_SECONDS=300
PRICE_DECIMALS=8
# JSON object with per-symbol precision overrides, e.g. {"BTC/USDT":2,"EUR/USD":5}
PRICE_DECIMALS_BY_SYMBOL={}

# --- Candles ---
CANDLES_ENABLED=true
CANDLE_FLUSH_SECONDS=60

# --- Database ---
# A full DSN wins over the POSTGRES_* fields (driver is upgraded to asyncpg).
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
# POSTGRES_SSL=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT_SECONDS=30
DB_STATEMENT_TIMEOUT_MS=0
