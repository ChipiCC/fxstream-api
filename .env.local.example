# Copy to `.env.local` and adjust as needed (read outside production).

# --- Application ---
ENVIRONMENT=local
DEBUG=false
DOCS_ENABLED=true
# API_V1_PREFIX=/api/v1

# --- HTTP ---
HOST=0.0.0.0
PORT=8000

# --- Observability ---
LOG_LEVEL=INFO
LOG_JSON=true
METRICS_ENABLED=true
METRICS_PATH=/metrics

# --- Security ---
# Comma-separated (or JSON array). Empty API_KEYS disables authentication.
API_KEYS=
CORS_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
ALLOWED_HOSTS=*
SECURITY_HEADERS_ENABLED=true
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- Database ---
# A full DSN wins over the POSTGRES_* fields (driver is upgraded to asyncpg).
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
# POSTGRES_SSL=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT_SECONDS=30
DB_STATEMENT_TIMEOUT_MS=0
